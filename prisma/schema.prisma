// Accounting + HR + Payroll Management System
// Multi-tenant Prisma schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =====================================================================
// TENANCY & IDENTITY
// =====================================================================

model Organization {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  logo          String?
  email         String?
  phone         String?
  address       String?
  currency      String   @default("NGN")
  countryCode   String   @default("NG")
  timezone      String   @default("Africa/Lagos")
  fiscalYear    String   @default("Jan-Dec")
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy        User?                 @relation("OrgCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  memberships      UserOrganization[]
  userPermissions  UserPermission[]
  roles            OrganizationRole[]
  departments      Department[]
  positions        Position[]
  employees        Employee[]
  salaryGrades     SalaryGrade[]
  benefitPlans     BenefitPlan[]
  bankRequests     BankDetailRequest[]
  leaveTypes       LeaveType[]
  payrollPeriods   PayrollPeriod[]
  payrollRuns      PayrollRun[]
  payrollConfigs   PayrollConfiguration[]
  accounts         Account[]
  accountingPeriods AccountingPeriod[]
  journalEntries   JournalEntry[]
  customers        Customer[]
  invoices         Invoice[]
  vendors          Vendor[]
  bills            Bill[]
  expenses         Expense[]
  expenseCategories ExpenseCategory[]
  payments         Payment[]
  countries        Country[]
  auditLogs        AuditLog[]
  settings         Setting[]
  notifications    Notification[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  image        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organizations   UserOrganization[]
  createdOrgs     Organization[]     @relation("OrgCreatedBy")
  auditLogs       AuditLog[]         @relation("AuditActor")
  permissionGrants UserPermission[]
  grantsMade      UserPermission[]   @relation("UserPermissionGrantedBy")
  journalsCreated JournalEntry[]     @relation("JournalCreated")
  journalsApproved JournalEntry[]    @relation("JournalApproved")
  journalsPosted  JournalEntry[]     @relation("JournalPosted")
  journalsReversed JournalEntry[]    @relation("JournalReversed")
}

// Join table for user -> organization with role
model UserOrganization {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  roleId         String?
  isOwner        Boolean  @default(false)
  status         String   @default("active")
  createdAt      DateTime @default(now())

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         OrganizationRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

// Organization-level roles (RBAC)
model OrganizationRole {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  UserOrganization[]
  permissions  RolePermission[]

  @@unique([organizationId, name])
}

model Permission {
  id          String @id @default(cuid())
  key         String @unique
  description String?
  category    String

  rolePermissions  RolePermission[]
  userPermissions  UserPermission[]
}

model RolePermission {
  id            String @id @default(cuid())
  roleId        String
  permissionKey String

  role       OrganizationRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission       @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@unique([roleId, permissionKey])
}

// Direct per-user permission grants (beyond role permissions), managed by Super Admin.
model UserPermission {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  permissionKey  String
  grantedById    String?
  grantedAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permission   Permission   @relation(fields: [permissionKey], references: [key], onDelete: Cascade)
  grantedBy    User?        @relation("UserPermissionGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([userId, organizationId, permissionKey])
  @@index([organizationId])
}

// =====================================================================
// HR
// =====================================================================

model Department {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  code           String?
  managerId      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  manager      Employee?    @relation("DeptManager", fields: [managerId], references: [id], onDelete: SetNull)
  employees    Employee[]

  @@unique([organizationId, name])
}

model Position {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees    Employee[]

  @@unique([organizationId, title])
}

model Employee {
  id              String   @id @default(cuid())
  organizationId  String
  employeeCode    String
  firstName       String
  lastName        String
  email           String?
  phone           String?
  address         String?
  dateOfBirth     DateTime?
  gender          String?
  maritalStatus   String?
  nationality     String?
  location        String?
  nextOfKinName   String?
  nextOfKinPhone  String?
  nextOfKinRelation String?
  isConfirmed     Boolean  @default(false)
  departmentId    String?
  positionId      String?
  managerId       String?
  hireDate        DateTime?
  terminationDate DateTime?
  employmentType  String   @default("permanent")
  status          String   @default("active")
  // Payroll-owned fields
  salaryGradeId   String?
  bankName        String?
  bankAccountNumber String?
  bankAccountName String?
  tin             String?
  taxOffice       String?
  pfaName         String?
  rsaPin          String?
  pensionPct      Decimal? @db.Decimal(5, 2)
  hmoPlan         String?
  nhiaPct         Decimal? @db.Decimal(5, 2)
  payFrequency    String   @default("monthly")
ssn             String?
  photoUrl        String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department      Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  position        Position?    @relation(fields: [positionId], references: [id], onDelete: SetNull)
  salaryGrade     SalaryGrade? @relation(fields: [salaryGradeId], references: [id], onDelete: SetNull)
  manager         Employee?    @relation("ManagerSubordinates", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates    Employee[]   @relation("ManagerSubordinates")
  managedDepartments Department[] @relation("DeptManager")
  documents       EmployeeDocument[]
  leaves          Leave[]
  coveringLeaves  Leave[] @relation("LeaveCover")
  attendances     Attendance[]
  salaryStructures SalaryStructure[]
  salaryChanges   SalaryChange[]
  benefitEnrollments EmployeeBenefit[]
  disciplinaryRecords DisciplinaryRecord[]
  acknowledgements PolicyAcknowledgement[]
  bankRequests    BankDetailRequest[]
  payrollLines    PayrollRunLine[]
  payslips        Payslip[]

  @@unique([organizationId, employeeCode])
  @@index([organizationId])
}

model SalaryGrade {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  minAmount      Decimal  @db.Decimal(18, 2)
  maxAmount      Decimal  @db.Decimal(18, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees    Employee[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

// Promotion / salary change history (promotion cycles track).
model SalaryChange {
  id            String   @id @default(cuid())
  employeeId    String
  previousBasic Decimal? @db.Decimal(18, 4)
  newBasic      Decimal? @db.Decimal(18, 4)
  effectiveFrom DateTime
  reason        String?
  changedById   String?
  changedAt     DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model BenefitPlan {
  id                  String   @id @default(cuid())
  organizationId      String
  name                String
  type                String   @default("hmo")
  description         String?
  requiresConfirmation Boolean @default(false)
  employerSharePct    Decimal? @db.Decimal(5, 2)
  employeeSharePct    Decimal? @db.Decimal(5, 2)
  premium             Decimal? @db.Decimal(18, 2)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enrollments  EmployeeBenefit[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model EmployeeBenefit {
  id                    String   @id @default(cuid())
  employeeId            String
  planId                String
  coverageTier          String?
  employeeContribution  Decimal? @db.Decimal(18, 2)
  effectiveFrom         DateTime @default(now())
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())

  employee Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  plan     BenefitPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([employeeId, planId])
  @@index([employeeId])
}

model DisciplinaryRecord {
  id           String   @id @default(cuid())
  employeeId   String
  incidentDate DateTime
  type         String
  description  String
  actionTaken  String?
  recordedById String?
  createdAt    DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model PolicyAcknowledgement {
  id            String   @id @default(cuid())
  employeeId    String
  policyName    String
  documentId    String?
  notes         String?
  acknowledgedAt DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model BankDetailRequest {
  id                 String   @id @default(cuid())
  organizationId     String
  employeeId         String
  requestedById      String?
  bankName           String
  bankAccountNumber  String
  bankAccountName    String
  status             String   @default("pending")
  notes              String?
  requestedAt        DateTime @default(now())
  reviewedById       String?
  reviewedAt         DateTime?
  reviewNotes        String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([organizationId, status])
}

model EmployeeDocument {
  id           String    @id @default(cuid())
  employeeId   String
  name         String
  type         String
  category     String?
  fileUrl      String
  notes        String?
  acknowledgedAt DateTime?
  createdAt    DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model LeaveType {
  id             String @id @default(cuid())
  organizationId String
  name           String
  daysAllowed    Int
  isPaid         Boolean @default(true)
  accrualPerMonth Decimal? @db.Decimal(6, 2)
  carryoverMax   Decimal @default(0) @db.Decimal(6, 2)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leaves       Leave[]

  @@unique([organizationId, name])
}

model Leave {
  id            String   @id @default(cuid())
  employeeId    String
  leaveTypeId   String
  startDate     DateTime
  endDate       DateTime
  days          Decimal  @db.Decimal(6, 1)
  reason        String?
  status        String   @default("pending")
  coveringForId String?
  approvedById  String?
  approvedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  coveringFor Employee? @relation("LeaveCover", fields: [coveringForId], references: [id], onDelete: SetNull)

  @@index([employeeId])
}

model Attendance {
  id          String   @id @default(cuid())
  employeeId  String
  date        DateTime
  checkIn     DateTime?
  checkOut    DateTime?
  hoursWorked Decimal? @db.Decimal(6, 2)
  overtimeHours Decimal @default(0) @db.Decimal(6, 2)
  status      String   @default("present")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
}

// =====================================================================
// PAYROLL CONFIGURATION
// =====================================================================

model Country {
  id             String   @id @default(cuid())
  code           String
  name           String
  currency       String
  organizationId String?
  createdAt      DateTime @default(now())

  organization   Organization?         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payrollConfigs PayrollConfiguration[]

  @@unique([code])
}

// Version-controlled, configurable payroll rules per country
model PayrollConfiguration {
  id                  String   @id @default(cuid())
  organizationId      String
  countryCode         String
  name                String
  currency            String
  taxYear             String?
  effectiveFrom       DateTime
  effectiveTo         DateTime?
  isActive            Boolean  @default(true)
  overtimeFactor      Decimal  @default(1) @db.Decimal(8, 4)
  workingDaysPerMonth Decimal @default(22) @db.Decimal(5, 2)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  country          Country?            @relation(fields: [countryCode], references: [code], onDelete: Restrict)
  taxRules         TaxRule[]
  deductionRules   DeductionRule[]
  contributionRules ContributionRule[]

  @@index([organizationId, countryCode])
}

model TaxRule {
  id                      String   @id @default(cuid())
  payrollConfigurationId String
  bracketOrder            Int
  lowerBound              Decimal  @db.Decimal(18, 4)
  upperBound              Decimal? @db.Decimal(18, 4)
  rate                    Decimal  @db.Decimal(8, 4)
  baseAmount              Decimal? @db.Decimal(18, 4)
  effectiveFrom           DateTime?
  effectiveTo             DateTime?
  createdAt               DateTime @default(now())

  configuration PayrollConfiguration @relation(fields: [payrollConfigurationId], references: [id], onDelete: Cascade)

  @@index([payrollConfigurationId, bracketOrder])
}

model DeductionRule {
  id                      String   @id @default(cuid())
  payrollConfigurationId String
  name                    String
  calculationType         String   @default("percent_gross")
  value                   Decimal  @db.Decimal(12, 4)
  cap                     Decimal? @db.Decimal(18, 4)
  effectiveFrom           DateTime?
  effectiveTo             DateTime?
  createdAt               DateTime @default(now())

  configuration PayrollConfiguration @relation(fields: [payrollConfigurationId], references: [id], onDelete: Cascade)
}

model ContributionRule {
  id                      String   @id @default(cuid())
  payrollConfigurationId String
  name                    String
  contributor             String   @default("employee")
  calculationType         String   @default("percent_gross")
  value                   Decimal  @db.Decimal(12, 4)
  cap                     Decimal? @db.Decimal(18, 4)
  effectiveFrom           DateTime?
  effectiveTo             DateTime?
  createdAt               DateTime @default(now())

  configuration PayrollConfiguration @relation(fields: [payrollConfigurationId], references: [id], onDelete: Cascade)
}

// =====================================================================
// PAYROLL EXECUTION
// =====================================================================

model SalaryStructure {
  id                     String   @id @default(cuid())
  employeeId             String
  basicSalary            Decimal  @db.Decimal(18, 4)
  allowances             Json?
  effectiveFrom          DateTime
  effectiveTo            DateTime?
  isActive               Boolean  @default(true)
  payrollConfigurationId String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model PayrollPeriod {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  startDate      DateTime
  endDate        DateTime
  payDate        DateTime?
  status         String   @default("open")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runs         PayrollRun[]

  @@unique([organizationId, name])
}

model PayrollRun {
  id              String   @id @default(cuid())
  periodId        String
  organizationId  String
  status          String   @default("draft")
  runDate         DateTime @default(now())
  submittedAt     DateTime?
  submittedById   String?
  approvedAt      DateTime?
  approvedById    String?
  finalizedAt     DateTime?
  finalizedById   String?
  totalGross      Decimal  @default(0) @db.Decimal(18, 4)
  totalDeductions Decimal  @default(0) @db.Decimal(18, 4)
  totalNet        Decimal  @default(0) @db.Decimal(18, 4)
  notes           String?
  journalEntryId  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  period       PayrollPeriod      @relation(fields: [periodId], references: [id], onDelete: Cascade)
  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines        PayrollRunLine[]

  @@unique([periodId])
}

model PayrollRunLine {
  id                 String   @id @default(cuid())
  runId              String
  employeeId         String
  basicPay           Decimal  @default(0) @db.Decimal(18, 4)
  allowances         Json?    @default("{}")
  grossPay           Decimal  @default(0) @db.Decimal(18, 4)
  totalAllowances    Decimal  @default(0) @db.Decimal(18, 4)
  deductions         Json?    @default("{}")
  totalDeductions    Decimal  @default(0) @db.Decimal(18, 4)
  totalContributions Decimal  @default(0) @db.Decimal(18, 4)
  overtimePay        Decimal  @default(0) @db.Decimal(18, 4)
  unpaidDeduction    Decimal  @default(0) @db.Decimal(18, 4)
  netPay             Decimal  @default(0) @db.Decimal(18, 4)
  employerContribJson Json?   @default("{}")
  taxJson            Json?    @default("{}")
  bankAccountNumber  String?
  status             String   @default("calculated")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  run      PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employee Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([runId])
}

model Payslip {
  id              String   @id @default(cuid())
  runLineId       String?  @unique
  employeeId      String
  organizationId  String
  periodName      String
  grossPay        Decimal  @db.Decimal(18, 4)
  totalDeductions Decimal  @db.Decimal(18, 4)
  netPay          Decimal  @db.Decimal(18, 4)
  breakdown       Json     @default("{}")
  issuedAt        DateTime?
  createdAt       DateTime @default(now())

  employee Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

// =====================================================================
// ACCOUNTING
// =====================================================================

model Account {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  type           String
  subtype        String?
  parentId       String?
  isActive       Boolean  @default(true)
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       Account?         @relation("AccountTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Account[]        @relation("AccountTree")
  journalLines JournalEntryLine[]

  @@unique([organizationId, code])
}

model AccountingPeriod {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  startDate      DateTime
  endDate        DateTime
  isClosed       Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  journalEntries JournalEntry[]

  @@unique([organizationId, name])
}

model JournalEntry {
  id             String   @id @default(cuid())
  organizationId String
  periodId       String?
  entryNumber    String
  date           DateTime
  reference      String?
  description    String?
  status         String   @default("posted")
  source         String?
  createdById    String?
  approvedById   String?
  approvedAt     DateTime?
  postedById     String?
  postedAt       DateTime?
  reversedById   String?
  reversedAt     DateTime?
  reversalOfId   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  period       AccountingPeriod?  @relation(fields: [periodId], references: [id], onDelete: SetNull)
  createdBy    User?              @relation("JournalCreated", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy   User?              @relation("JournalApproved", fields: [approvedById], references: [id], onDelete: SetNull)
  postedBy     User?              @relation("JournalPosted", fields: [postedById], references: [id], onDelete: SetNull)
  reversedBy   User?              @relation("JournalReversed", fields: [reversedById], references: [id], onDelete: SetNull)
  reversalOf   JournalEntry?      @relation("JournalReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversals    JournalEntry[]     @relation("JournalReversal")
  lines        JournalEntryLine[]

  @@unique([organizationId, entryNumber])
  @@index([organizationId, status])
  @@index([date])
}

model JournalEntryLine {
  id             String   @id @default(cuid())
  journalEntryId String
  accountId      String
  description    String?
  debit          Decimal  @default(0) @db.Decimal(18, 4)
  credit         Decimal  @default(0) @db.Decimal(18, 4)
  createdAt      DateTime @default(now())

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([journalEntryId])
}

model Customer {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  email          String?
  phone          String?
  address        String?
  taxId          String?
  openingBalance Decimal  @default(0) @db.Decimal(18, 4)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices      Invoice[]
  paymentRecords Payment[]   @relation("CustomerPayments")

  @@index([organizationId])
}

model Invoice {
  id             String   @id @default(cuid())
  organizationId String
  customerId     String
  invoiceNumber  String
  issueDate      DateTime @default(now())
  dueDate        DateTime?
  status         String   @default("draft")
  subtotal       Decimal  @default(0) @db.Decimal(18, 4)
  taxAmount      Decimal  @default(0) @db.Decimal(18, 4)
  discount       Decimal  @default(0) @db.Decimal(18, 4)
  total          Decimal  @default(0) @db.Decimal(18, 4)
  amountPaid     Decimal  @default(0) @db.Decimal(18, 4)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lines        InvoiceLine[]
  payments     Payment[]    @relation("PaymentInvoice")

  @@index([organizationId])
}

model InvoiceLine {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  quantity    Decimal  @default(1) @db.Decimal(12, 2)
  unitPrice   Decimal  @default(0) @db.Decimal(18, 4)
  amount      Decimal  @default(0) @db.Decimal(18, 4)
  accountId   String?
  createdAt   DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Vendor {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  email          String?
  phone          String?
  address        String?
  taxId          String?
  openingBalance Decimal  @default(0) @db.Decimal(18, 4)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bills         Bill[]
  expenses      Expense[]
  paymentRecords Payment[]   @relation("VendorPayments")

  @@index([organizationId])
}

model Bill {
  id             String   @id @default(cuid())
  organizationId String
  vendorId       String
  billNumber     String
  issueDate      DateTime @default(now())
  dueDate        DateTime?
  status         String   @default("draft")
  subtotal       Decimal  @default(0) @db.Decimal(18, 4)
  taxAmount      Decimal  @default(0) @db.Decimal(18, 4)
  total          Decimal  @default(0) @db.Decimal(18, 4)
  amountPaid     Decimal  @default(0) @db.Decimal(18, 4)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor       Vendor       @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  lines        BillLine[]
  payments     Payment[]    @relation("PaymentBill")

  @@index([organizationId])
}

model BillLine {
  id          String   @id @default(cuid())
  billId      String
  description String
  quantity    Decimal  @default(1) @db.Decimal(12, 2)
  unitPrice   Decimal  @default(0) @db.Decimal(18, 4)
  amount      Decimal  @default(0) @db.Decimal(18, 4)
  accountId   String?
  createdAt   DateTime @default(now())

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)
}

model Expense {
  id             String   @id @default(cuid())
  organizationId String
  categoryId     String?
  accountId      String?
  amount         Decimal  @db.Decimal(18, 4)
  date           DateTime @default(now())
  description    String?
  vendorId       String?
  status         String   @default("pending")
  approvedById   String?
  approvedAt     DateTime?
  receiptUrl     String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  vendor       Vendor?          @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@index([organizationId])
}

model ExpenseCategory {
  id             String @id @default(cuid())
  organizationId String
  name           String
  accountId      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expenses     Expense[]

  @@unique([organizationId, name])
}

model Payment {
  id             String   @id @default(cuid())
  organizationId String
  invoiceId      String?
  billId         String?
  customerId     String?
  vendorId       String?
  amount         Decimal  @db.Decimal(18, 4)
  method         String   @default("bank")
  reference      String?
  date           DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice?     @relation("PaymentInvoice", fields: [invoiceId], references: [id], onDelete: SetNull)
  bill         Bill?        @relation("PaymentBill", fields: [billId], references: [id], onDelete: SetNull)
  customer     Customer?    @relation("CustomerPayments", fields: [customerId], references: [id], onDelete: SetNull)
  vendor       Vendor?      @relation("VendorPayments", fields: [vendorId], references: [id], onDelete: SetNull)

  @@index([organizationId])
}

// =====================================================================
// ADMINISTRATION / CROSS-CUTTING
// =====================================================================

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  entity         String
  entityId       String?
  metadata       Json?
  ip             String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?         @relation("AuditActor", fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([createdAt])
}

model Setting {
  id             String   @id @default(cuid())
  organizationId String
  key            String
  value          Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
}

model Notification {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  title          String
  message        String?
  type           String   @default("info")
  isRead         Boolean  @default(false)
  link           String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}
